# Add each block when the corresponding app pins the new published module release
# and its cookie-auth builds are ready. Remove retain_spa_redirects from the
# forward_auth input. These chain with the app module's unindexed -> [0] move.

moved {
  from = module.setup_hello_app.module.setup_hello_spa[0]
  to   = module.setup_hello_app.module.setup_hello_web[0]
}

moved {
  from = module.setup_cooking_app.module.setup_cooking_spa[0]
  to   = module.setup_cooking_app.module.setup_cooking_web[0]
}
